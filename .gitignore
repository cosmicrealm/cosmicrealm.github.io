# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore local agent design and worktree sandboxes.
.superpowers/
.worktrees/

# Ignore files created by MacOS
.DS_Store
__pycache__/
*.py[cod]

# Ignore local source notes and page-generation prompts.
knowledge/
foundations/codex_*.md
foundations/*/codex_*.md
foundations/*/README.md
foundations/diffusion-distillation-math-lab/static/
Projects/*/README.md

# Style-Talking media is hosted on R2; keep local video copies out of git.
projects/style-talking/static/videos/
